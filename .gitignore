# ═══════════════════════════════════════════════════════════════════════════════
# BIZRA SCAFFOLD - .gitignore
# ═══════════════════════════════════════════════════════════════════════════════
# This file ensures sensitive, generated, and environment-specific files
# are never accidentally committed to version control.

# ═══════════════════════════════════════════════════════════════════════════════
# 🔴 SECURITY-CRITICAL: SECRETS & KEYS
# ═══════════════════════════════════════════════════════════════════════════════
# NEVER commit private keys, secrets, or credentials
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.secret
*_secret*
*_private*
private_*
secret_*

# Environment files with secrets
.env
.env.*
!.env.example
.envrc
*.local

# AWS/Cloud credentials
.aws/
credentials
credentials.*

# API keys and tokens
**/api_key*
**/apikey*
**/token*
!**/token*.py  # Allow token-related code files
!**/tokenizer*

# ═══════════════════════════════════════════════════════════════════════════════
# Python Artifacts
# ═══════════════════════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/
conda-env/

# ═══════════════════════════════════════════════════════════════════════════════
# Testing & Coverage
# ═══════════════════════════════════════════════════════════════════════════════
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.coverage
.hypothesis/
.benchmarks/

# ═══════════════════════════════════════════════════════════════════════════════
# IDE & Editor
# ═══════════════════════════════════════════════════════════════════════════════
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ═══════════════════════════════════════════════════════════════════════════════
# Build Artifacts
# ═══════════════════════════════════════════════════════════════════════════════
# Rust
target/
Cargo.lock
**/*.rs.bk

# Node.js (if any frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
package-lock.json

# ═══════════════════════════════════════════════════════════════════════════════
# Database & Logs
# ═══════════════════════════════════════════════════════════════════════════════
*.db
*.sqlite
*.sqlite3
*.log
logs/
*.log.*

# Evidence artifacts (hash-only; raw outputs must stay outside repo)
evidence/**/*.md
/RECOVERED_MASTERPIECE.md
/PEAK_IMPLEMENTATION_EVIDENCE.md

# Neo4j local data
neo4j_data/
data/neo4j/
data/manifests/

# ═══════════════════════════════════════════════════════════════════════════════
# OS-specific
# ═══════════════════════════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ═══════════════════════════════════════════════════════════════════════════════
# Docker & K8s Local
# ═══════════════════════════════════════════════════════════════════════════════
docker-compose.override.yml
*.override.yml
.docker/

# ═══════════════════════════════════════════════════════════════════════════════
# Jupyter Notebooks
# ═══════════════════════════════════════════════════════════════════════════════
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ═══════════════════════════════════════════════════════════════════════════════
# Documentation Build
# ═══════════════════════════════════════════════════════════════════════════════
docs/_build/
site/
.mkdocs/

# ═══════════════════════════════════════════════════════════════════════════════
# Temporary & Misc
# ═══════════════════════════════════════════════════════════════════════════════
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
.cache/

# Quarantine: unknown local artifact
BIZRA BRAND idintiy.html

_garbage/
data/ops/
*.vsix
